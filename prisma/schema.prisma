generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =======================
// Shared & Enhanced Models
// =======================

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique // From taepyeong-home
  order     Int       @default(0) // From taepyeong-sell
  mallType  String    @default("HOME")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String              @id @default(cuid())
  name         String
  spec         String              @default("") // From taepyeong-home
  desc1        String?             // From taepyeong-home
  desc2        String?             // From taepyeong-home
  desc3        String?             // From taepyeong-home
  desc4        String?             // From taepyeong-home
  desc5        String?             // From taepyeong-home
  description  String?             // From taepyeong-sell
  imageUrl     String?
  isActive     Boolean             @default(true) // From taepyeong-sell
  isBestSeller Boolean             @default(false) // From taepyeong-sell
  isSale       Boolean             @default(false) // From taepyeong-sell
  order        Int                 @default(0)
  category     Category            @relation(fields: [categoryId], references: [id])
  categoryId   String
  mallType     String              @default("HOME")
  options      ProductOption[]     // taepyeong-sell relation
  orderItems   OrderItem[]         // taepyeong-sell relation
  dealProducts DealEventProduct[]  // taepyeong-sell relation
  partnerOverrides PartnerProductOverride[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  email     String?  @unique // From taepyeong-home
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminVerificationCode {
  id        String   @id @default(cuid())
  code      String
  tempToken String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) // From taepyeong-home
  updatedAt DateTime @updatedAt      // From taepyeong-home
}

// =======================
// taepyeong-sell Exclusives
// =======================

model ProductOption {
  id            String      @id @default(cuid())
  name          String
  originalPrice Int
  salePrice     Int
  discountRate  Int         @default(0)
  stock         Int         @default(9999)
  isDefault     Boolean     @default(false)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  orderItems    OrderItem[]
  partnerOverrides PartnerOptionOverride[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model DealEvent {
  id           String             @id @default(cuid())
  title        String
  subtitle     String?
  bannerImage  String?
  isActive     Boolean            @default(true)
  startDate    DateTime?
  endDate      DateTime?
  dealProducts DealEventProduct[]
  orders       Order[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model DealEventProduct {
  id          String    @id @default(cuid())
  dealEvent   DealEvent @relation(fields: [dealEventId], references: [id], onDelete: Cascade)
  dealEventId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  createdAt   DateTime  @default(now())

  @@unique([dealEventId, productId])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  ordererName           String
  ordererPhone          String
  ordererZipCode        String
  ordererAddress        String
  ordererAddressDetail  String?
  orderPassword         String
  receiverName          String
  receiverPhone         String
  receiverZipCode       String
  receiverAddress       String
  receiverAddressDetail String?
  shippingMemo          String?
  totalAmount           Int
  paymentMethod         String      @default("BANK_TRANSFER")
  depositorName         String?
  privacyConsent        Boolean     @default(false)
  cashReceiptType       String      @default("NONE")
  cashReceiptPhone      String?
  businessNumber        String?
  trackingNo            String?
  courier               String?
  status                String      @default("PENDING")
  dealEvent             DealEvent?  @relation(fields: [dealEventId], references: [id])
  dealEventId           String?
  partner               Partner?    @relation(fields: [partnerId], references: [id])
  partnerId             String?
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([trackingNo])
}

// =======================
// B2B Partner Models
// =======================

model Partner {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoText    String?
  logoSubtext String?
  logoImageUrl String?
  bannerImage String?
  bannerTitle String?
  bannerSubtitle String?
  cartTitle   String?
  accessCode  String?
  accessDuration Int @default(30)
  isActive    Boolean  @default(true)
  
  overrides   PartnerProductOverride[]
  orders      Order[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PartnerProductOverride {
  id              String   @id @default(cuid())
  partnerId       String
  productId       String
  
  customName      String?
  customDesc      String?
  customImage     String?
  isHidden        Boolean  @default(false)
  
  optionOverrides PartnerOptionOverride[]

  partner         Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([partnerId, productId])
}

model PartnerOptionOverride {
  id                 String   @id @default(cuid())
  overrideId         String
  productOptionId    String
  
  customSalePrice    Int?
  customDiscountRate Int?

  override           PartnerProductOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)
  productOption      ProductOption          @relation(fields: [productOptionId], references: [id], onDelete: Cascade)

  @@unique([overrideId, productOptionId])
}

model OrderItem {
  id              String        @id @default(cuid())
  quantity        Int
  unitPrice       Int
  totalPrice      Int
  productName     String
  optionName      String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  product         Product       @relation(fields: [productId], references: [id])
  productId       String
  productOption   ProductOption @relation(fields: [productOptionId], references: [id])
  productOptionId String
  trackingNo      String?
  courier         String?
  createdAt       DateTime      @default(now())
}

// =======================
// taepyeong-home Exclusives
// =======================

model MainSlide {
  id          String   @id @default(cuid())
  accent      String   
  title       String   
  description String   
  imageUrl    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  address   String?
  details   String
  status    String   @default("UNREAD") 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
